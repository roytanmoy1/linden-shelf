{
  "name": "linden-shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.21.3",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build --workspace @linden-shelf/contracts && npm run typecheck --workspaces && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run --exclude **/*.integration.test.ts",
    "test:integration": "vitest run .integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "npm run build && node tests/server-smoke.mjs",
    "start:api": "npm run start --workspace @linden-shelf/catalogue-api",
    "dev": "npm run start:web",
    "start:web": "npm run dev --workspace @linden-shelf/catalogue-web",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^4.0.0",
    "yaml": "2.9.1"
  }
}
